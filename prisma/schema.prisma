// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String          @id @default(cuid())
  clerkId        String          @unique
  email          String          @unique
  plan           Plan            @default(FREE)

  // Credits
  subscriptionCredits Int       @default(3) // trial = 3; sub renewal resets to 50; expires at period end
  topupCredits        Int       @default(0) // never expires
  creditsReset        DateTime? // null until subscribed; then = next reset date

  // Stripe linkage
  stripeCustomerId      String?   @unique
  stripeSubscriptionId  String?   @unique
  subscriptionStatus    String?   // active, past_due, canceled, incomplete, ...
  subscriptionPeriodEnd DateTime? // current_period_end from Stripe

  preferredBg          BackgroundType? @map("preferred_bg")
  preferredBgKey       String?         @map("preferred_bg_key")
  preferredBgPresetKey String?         @map("preferred_bg_preset_key")

  // UI language preference; null = follow IP/cookie default. "hu" | "en"
  locale               String?

  projects      Project[]
  payments      Payment[]
  supportThread SupportThread?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Payment {
  id                      String   @id @default(cuid())
  userId                  String
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCheckoutSessionId String?  @unique
  stripeInvoiceId         String?  @unique
  type                    String   // "subscription" | "topup"
  amountHuf               Int
  creditsAdded            Int
  createdAt               DateTime @default(now())

  @@index([userId])
}

model WebhookEvent {
  id          String   @id // Stripe event.id (idempotency key)
  type        String
  processedAt DateTime @default(now())
}

model SupportThread {
  id            String           @id @default(cuid())
  userId        String           @unique // one thread per user (reopens on new message)
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status        String           @default("open") // "open" | "closed"
  lastMessageAt DateTime         @default(now())
  unreadByUser  Int              @default(0) // admin messages user hasn't seen
  unreadByAdmin Int              @default(0) // user messages admin hasn't seen
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  messages      SupportMessage[]

  @@index([status, lastMessageAt])
}

model SupportMessage {
  id        String        @id @default(cuid())
  threadId  String
  thread    SupportThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author    SupportAuthor
  body      String
  createdAt DateTime      @default(now())

  @@index([threadId, createdAt])
}

enum SupportAuthor {
  USER
  ADMIN
}

model Project {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                String
  backgroundType      BackgroundType
  backgroundUrl       String?
  backgroundPresetKey String?        @map("background_preset_key")
  images         Image[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([userId])
}

model Image {
  id           String        @id @default(cuid())
  projectId    String
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  originalKey  String
  cutoutKey    String?
  processedKey String?
  rotateDeg    Float         @default(0)
  offsetXPct   Float         @default(0)
  offsetYPct   Float         @default(0)
  zoom         Float         @default(1)
  status       ProcessStatus @default(PENDING)
  errorMessage String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([projectId])
  @@index([status])
}

enum Plan {
  FREE
  PRO
  BUSINESS
}

enum BackgroundType {
  STUDIO_GREY
  SHOWROOM
  OUTDOOR_ASPHALT
  CUSTOM
}

enum ProcessStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}
